{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>remi-gelinas/renovate:config.json5"],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^profiles/.*\.cue$/'],
      matchStrings: [
        // Talos versions
        '\\\/\\\/ renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+?.*"(?<currentValue>.*?)"',

        // System extensions
        '\\\/\\\/ renovate: datasource=(?<datasource>.*?)\\s*?"(?<depName>\\S+):(?<currentValue>\\S+)"'
      ],
    },
  ],
}